# Copy to .env. PUBLIC_HOST is what a browser types to reach this machine.
PUBLIC_HOST=localhost
# URL of the Cashu mint as both browsers and containers see it (the dev mint profile listens on 3338)
MINT_URL=http://localhost:3338
POSTGRES_PASSWORD=change-me
# 64 hex characters, keep it: the crew relay signs group state with it   (openssl rand -hex 32)
CREW_RELAY_SECRET=
# Optional Lightning backend for the key server and split service: phoenixd or LND REST
PHOENIXD_URL=
PHOENIXD_PASSWORD=
LND_URL=
LND_MACAROON=
# agent / verifier profiles
AGENT_NSEC=
AGENT_LOCK_PRIVKEY=
VERIFIER_NSEC=
# comma-separated verifier pubkeys the apps trust by default
VERIFIERS=
FAL_KEY=
MOCK=
# payouts profile: set to 1 only after you have read docs/STATUS.md on custody
SPLIT_ACKNOWLEDGE_CUSTODY=
FIAT_DEMO=
# media image: `services` (default) or `services-asr` (adds local speech-to-text for caption generation)
MEDIA_TARGET=services
