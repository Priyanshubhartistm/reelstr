{
  "name": "reelstr",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "e2e",
    "interop"
  ],
  "scripts": {
    "check": "biome check . && tsc -b && bun test packages services interop",
    "test": "bun test packages services interop",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test:fast": "bun test packages/protocol packages/nostr packages/blossom",
    "test:e2e": "bun test e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
